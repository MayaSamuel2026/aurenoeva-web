[Unit]
Description=AURENOEVA canonical catalogue publication (independent of crawling)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aurenoeva
Group=aurenoeva
WorkingDirectory=/opt/aurenoeva
ExecStart=/usr/bin/python3 /opt/aurenoeva/tools/catalogue_publish.py
# Existing publisher locks and verified SHA snapshot prevent overlapping writes.
# The 120 MB website upload may outlast a crawler cycle without killing it.
TimeoutStartSec=5400
CPUWeight=100
IOWeight=100
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aurenoeva
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
