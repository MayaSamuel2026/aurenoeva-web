[Unit]
Description=AURENOEVA catalogue overnight harvest (Europe/Berlin local time)

[Timer]
# One eight-hour, resumable harvest and one end-of-run publication overnight.
# No daytime catch-up after a reboot: the next run starts at 22:00 Berlin time.
OnCalendar=*-*-* 22:00:00 Europe/Berlin
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=aurenoeva-catalogue.service

[Install]
WantedBy=timers.target
