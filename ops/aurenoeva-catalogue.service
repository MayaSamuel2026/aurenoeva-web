[Unit]
Description=AURENOEVA fast worldwide product + vendor harvester V4
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aurenoeva
Group=aurenoeva
WorkingDirectory=/opt/aurenoeva
# One qualified update attempt before each run; failure never interrupts harvesting.
# - ignores transient update failures; + runs the narrowly scoped installer as root.
ExecStartPre=-+/usr/bin/python3 /opt/aurenoeva/tools/catalogue_auto_update.py
ExecStart=/usr/bin/python3 /opt/aurenoeva/tools/catalogue_harvester.py --db /var/lib/aurenoeva/catalogue.sqlite3 --sources /opt/aurenoeva/config/catalogue_harvester.json --export /var/lib/aurenoeva/catalogue-public.json --max-pages 1000000 --max-seconds 21600 --workers 8
# Seven-hour window includes export and one full verified website publication.
# Give this bounded overnight catalogue run precedence over continuous
# research workloads; cgroup weights apply only while this job is active.
CPUWeight=600
IOWeight=250
TimeoutStartSec=28800
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aurenoeva
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
