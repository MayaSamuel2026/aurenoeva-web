[Unit]
Description=AURENOEVA fast worldwide product + vendor harvester V4
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aurenoeva
Group=aurenoeva
WorkingDirectory=/opt/aurenoeva
ExecStart=/usr/bin/python3 /opt/aurenoeva/tools/catalogue_harvester.py --db /var/lib/aurenoeva/catalogue.sqlite3 --sources /opt/aurenoeva/config/catalogue_harvester.json --export /var/lib/aurenoeva/catalogue-public.json --max-pages 1500 --max-seconds 2700 --workers 10
TimeoutStartSec=3300
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aurenoeva
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
