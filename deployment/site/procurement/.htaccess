Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(private_cases|supplier_intelligence|supplier_discovery|staff_auth|mail_center|supplier-refresh-cli|setup-cli)\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set Cache-Control "private, no-store"
</IfModule>
