# AURENOEVA search-engine entry routes; preserve the existing site and basket.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^sitemap\.xml$ seo.php?feed=index [L,NC]
RewriteRule ^sitemaps/taxonomy-(en|de)\.xml$ seo.php?feed=taxonomy&lang=$1 [L,NC]
RewriteRule ^sitemaps/products-(en|de)-([1-9][0-9]*)\.xml$ seo.php?feed=products&lang=$1&page=$2 [L,NC]
RewriteRule ^(en|de)/(parts|teile)/([a-z0-9-]+)/?$ seo.php?lang=$1&kind=product&key=$3 [L,NC]
RewriteRule ^(en|de)/(manufacturers|hersteller)/([a-z0-9-]+)/?$ seo.php?lang=$1&kind=manufacturer&key=$3 [L,NC]
RewriteRule ^(en|de)/(categories|kategorien)/(laboratory|test|medical|industrial|energy|marine|aviation)/([a-z0-9-]+)/?$ seo.php?lang=$1&kind=category&sector=$3&key=$4 [L,NC]
</IfModule>

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Preserve old WordPress public routes during the static cutover.
RewriteRule ^how-it-works/?$ /how-it-works.html [R=301,L,NE]
RewriteRule ^industries/?$ /industries.html [R=301,L,NE]
RewriteRule ^trust-methodology/?$ /trust-methodology.html [R=301,L,NE]
RewriteRule ^for-suppliers/?$ /suppliers.html [R=301,L,NE]
RewriteRule ^about/?$ /about.html [R=301,L,NE]
RewriteRule ^contact/?$ /about.html [R=301,L,NE]
RewriteRule ^start-a-requirement/?$ /requirement.html [R=301,L,NE]
RewriteRule ^requirement-lens/?$ /#what-site-does [R=301,L,NE]
RewriteRule ^evidence-passport/?$ /#what-site-does [R=301,L,NE]
RewriteRule ^acquisition-instrument/?$ /#what-site-does [R=301,L,NE]
RewriteRule ^legal/company-information/?$ /imprint.html [R=301,L,NE]
RewriteRule ^privacy/?$ /privacy.html [R=301,L,NE]
RewriteRule ^terms/?$ /terms.html [R=301,L,NE]
RewriteRule ^cookies/?$ /cookies.html [R=301,L,NE]

# Never expose PHP helper source as a public document.
RewriteRule ^_form_common\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
