# Aurenoeva V7.4 NOEVA CORE binding — example only.
# Configure these on the Hostinger/PHP runtime. Do not commit real secrets.

AURENOEVA_CORE_BASE_URL=
AURENOEVA_CORE_HEALTH_PATH=/api/health
AURENOEVA_CORE_CATALOGUE_PATH=/api/catalogue
AURENOEVA_CORE_REQUIREMENT_PATH=/api/public/v1/aurenoeva/requirements

# Optional exact endpoint overrides
AURENOEVA_CORE_HEALTH_URL=
AURENOEVA_CORE_SEARCH_URL=
AURENOEVA_CORE_REQUIREMENT_URL=

# Server-side authentication. Leave out of Git.
AURENOEVA_CORE_API_TOKEN=
AURENOEVA_CORE_API_KEY=
